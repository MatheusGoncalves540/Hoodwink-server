ENVIRONMENT=local

GAME_SERVER_URL=http://localhost:5000
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

PORT=5000

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis

# Intervalo (em segundos) para envio de heartbeats
HEARTBEAT_INTERVAL=5
HEARTBEAT_TTL=10

BACKEND_JWT_SECRET=00000000-0000-0000-0000-000000000001
JWT_SECRET=00000000-0000-0000-0000-000000000000
JWT_EXPIRATION=2

BACKEND_API_KEY=00000000-0000-0000-0000-000000000000

ROOM_TTL=5
ROOM_AFK_TTL_LIMIT=180

# Quantidade de eventos processados por lote no processador de eventos do jogo
PROCESSOR_BATCH_SIZE=5
PROCESSOR_INTERVAL_MS=300

# UNSAFE_DEBUG=false
# DEBUG=true
# CORS=false
